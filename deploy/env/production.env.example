# Copy to /etc/mu-hub/production.env (owner root:muhub, mode 0640). Non-secret settings only live in this
# example. Secrets (provider keys, tokens) are added BY HAND on the VM, never committed, never pasted into
# a chat. The names the hub reads are listed under "Secret names" so nobody has to guess; values stay blank here.

# Environment identity (the hub reports these on /__health).
MU_HUB_ROLE=cloud
ARGENTIC_PORT=8081
# The systemd unit sets MU_DATA_DIR=/var/lib/mu-hub/production; do not repeat it here.

# Memory. Hindsight and its Postgres run on this VM, bound to loopback.
MU_MEMORY_WRITES=read
HINDSIGHT_URL=http://127.0.0.1:8878
HINDSIGHT_BANK=mu-shared
# The ONE authoritative vault for this environment (see CLOUD-ARCHITECTURE.md, Memory).
MU_WIKI_ROOT=/var/lib/mu-hub/production-vault

# Secret names (add with values by hand, mode 0640, never in git):
#   HINDSIGHT_APPROVAL_SECRET_FILE   path to a root-only file, not the secret itself
#   OPENROUTER_API_KEY, GROQ_API_KEY, GEMINI_API_KEY, ELEVENLABS_API_KEY
#   STRIPE_SECRET_KEY, RETELL_API_KEY, TWILIO_AUTH_TOKEN, TELEGRAM_BOT_TOKEN
# Only add the ones this instance really needs. Staging must use test or sandbox keys, or none.
