# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local
.env
.env.*

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Generated by scripts/aggregate.ts — contains real machine data.
# live-data.example.json is the committed sanitized template.
src/data/live-data.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
claude-os

# graphify scratch output (regenerated on ingest)
graphify-out/
# per-project knowledge graphs generated locally by graphify ingest — machine
# data (can encode a private repo's structure), regenerated on demand. Ignore
# ALL of them so a user can't accidentally commit their private-repo graph;
# the two shipped seeds are force-tracked below.
src/data/graphs/*.json
!src/data/graphs/index.json
!src/data/graphs/power-design.json

# Licensed colour LUTs are not redistributable; imported ones stay out of the package.
public/color-lab/luts/imported/

# Operator's private records and imports
.operator-data/

# Per-worktree Vite dependency cache
.preview-cache/

# Optional Python runtime bytecode and private export files
__pycache__/
*.pyc
!.env.example

# Local QA captures and generated tool receipts may contain private workspace evidence.
outputs/

# Local review screenshots (live call data, masked) — kept on disk, never committed.
review/
