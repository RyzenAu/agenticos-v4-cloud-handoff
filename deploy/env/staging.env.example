# Copy to /etc/mu-hub/staging.env (owner root:muhub, mode 0640). Same rules as production.env.example.
# Staging runs a release candidate against a COPY of production data (a restored backup), on its own port,
# its own data directory and its own Tailscale Serve port. It must never hold live payment, phone or
# messaging credentials: staging does not send anything to real people.

MU_HUB_ROLE=cloud
ARGENTIC_PORT=8082

# Memory writes stay off in staging so a test cannot write into the shared pool.
MU_MEMORY_WRITES=off
HINDSIGHT_URL=off
MU_WIKI_ROOT=/var/lib/mu-hub/staging-vault

# Secret names: add none of the live ones. If a feature needs a key to be exercised, use a test or sandbox key.
